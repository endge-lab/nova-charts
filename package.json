{
  "name": "@endge/nova-charts",
  "private": false,
  "version": "0.10.5",
  "type": "module",
  "module": "./dist/nova-charts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nova-charts.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "test": "vitest run --config vite.config.ts",
    "bench": "vitest run --config vite.bench.config.ts",
    "lint-check": "eslint . --cache",
    "lint-fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@endge/nova": "workspace:*",
    "@endge/nova-ui-kit": "workspace:*",
    "@endge/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/language-core": "^3.3.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.9.1",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  }
}
